<jasperReport name="nota" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7ea05f45-88ef-4482-8fa5-5e3585cf28ae">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Postgres connection"/>
	<style name="zebraRow" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="bookingId" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT c.name AS cliente,
       c.phone,
       c.email,
       t.name AS passeio,
       b.custom_schedule,
       b.created_at AS data_reserva,
       b.booking_id AS numero,
       b.total_price_snapshot AS total,
       b.unit_price_snapshot AS preco_unitario,
       b.manual_discount AS desconto,
       b.total_price_snapshot - pay.expected_amount AS saldo_restante,
       current_status AS status,
       g.name AS integrante,
       g.is_lap_child AS integrante_lap,
       p.location_name,
       p.cep,
       pay.expected_amount,
       pay.paid_at AS data_pagamento,
       u.user_name AS atendente

FROM client c
INNER JOIN booking b ON b.client_id = c.client_id
INNER JOIN tour t ON t.tour_id = b.tour_id
LEFT JOIN group_member g ON g.booking_id = b.booking_id
INNER JOIN pickup_location p ON p.pickup_id = b.pickup_id
INNER JOIN payment pay ON pay.payment_id = b.payment_id
INNER JOIN users u ON u.user_id = b.user_id

WHERE b.booking_id = $P{bookingId}
ORDER BY g.name ASC NULLS LAST;
]]></query>
	<field name="cliente" class="java.lang.String"/>
	<field name="phone" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="passeio" class="java.lang.String"/>
	<field name="custom_schedule" class="java.sql.Timestamp"/>
