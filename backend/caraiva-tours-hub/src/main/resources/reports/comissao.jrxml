<jasperReport name="comissao" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c43097bc-faea-4e6e-97e2-2444f4454a3a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Postgres connection"/>
	<parameter name="P_USER_ID" class="java.lang.Long"/>
	<parameter name="P_PERIOD_START" class="java.sql.Timestamp"/>
	<parameter name="P_PERIOD_END" class="java.sql.Timestamp"/>
	<query language="SQL"><![CDATA[SELECT
    u.user_name AS funcionario,
    b.custom_schedule AS data_reserva,
    b.total_price_snapshot AS valor_total,
    b.commission_snapshot AS comissao_reserva,
    SUM(b.commission_snapshot) OVER() AS total_comissao_mes,
    COUNT(*) OVER() AS qtd_reservas,
    t.name AS passeio,
    t.commission_type,
    t.commission_value,
    c.name AS cliente,
    c.phone AS telefone_cliente,
    b.current_status
FROM users u
    INNER JOIN booking b ON b.user_id = u.user_id
    INNER JOIN Tour t ON t.tour_id = b.tour_id
    INNER JOIN client c ON c.client_id = b.client_id
WHERE u.user_id = $P{P_USER_ID}
  AND b.custom_schedule >= $P{P_PERIOD_START}
  AND b.custom_schedule < $P{P_PERIOD_END}
  AND b.current_status IN ('CONFIRMED', 'COMPLETED', 'CANCELLED')
ORDER BY b.custom_schedule DESC]]></query>
	<field name="funcionario" class="java.lang.String"/>
	<field name="data_reserva" class="java.time.LocalDateTime"/>
	<field name="valor_total" class="java.math.BigDecimal"/>
	<field name="comissao_reserva" class="java.math.BigDecimal"/>
	<field name="total_comissao_mes" class="java.math.BigDecimal"/>
	<field name="qtd_reservas" class="java.lang.Long"/>
	<field name="passeio" class="java.lang.String"/>
